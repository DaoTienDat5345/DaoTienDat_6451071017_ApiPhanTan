{
  "name": "facebook-webhook-microservices",
  "version": "1.0.0",
  "private": true,
  "description": "Facebook Page Webhook multi-service project",
  "type": "commonjs",
  "scripts": {
    "start:webhook": "npm --prefix webhook-service start",
    "start:core": "npm --prefix core-service start",
    "start:backend": "npm --prefix backend-api start",
    "start:retry": "npm --prefix retry-service start",
    "subscribe:page": "node subscribe.js",
    "test:syntax": "node --check webhook-service/server.js && node --check core-service/server.js && node --check backend-api/server.js && node --check retry-service/server.js && node --check subscribe.js",
    "test:cases": "powershell -ExecutionPolicy Bypass -File .\\test-cases.ps1",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "dotenv": "^17.4.2"
  }
}
