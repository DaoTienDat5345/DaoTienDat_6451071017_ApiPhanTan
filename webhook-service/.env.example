# --- Webhook HTTP (đề yêu cầu port 3001) ---
PORT=3001

# Chuỗi verify cho Facebook webhook (Facebook App → Webhooks → Verify Token)
VERIFY_TOKEN=dat123

# App Secret — dùng để kiểm tra header X-Hub-Signature-256 từ Meta
# Để test bằng test-cases.ps1 cục bộ: để trống (sẽ bỏ qua kiểm tra chữ ký)
FACEBOOK_APP_SECRET=


# --- Kafka ---
KAFKA_BROKER=localhost:29092
KAFKA_CLIENT_ID=webhook-service
KAFKA_TOPIC=raw_events
KAFKA_STATUS_TOPIC=processing_status
KAFKA_ACTION_TOPIC=moderation_actions
KAFKA_SEND_FAILED_TOPIC=send_failed
KAFKA_DEAD_LETTER_TOPIC=dead_letter
KAFKA_CONSUMER_GROUP_ID=core-service-group
KAFKA_RETRY_GROUP_ID=retry-service-group

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=30000

# --- AI (classification) ---
# Dùng mock: AI_PROVIDER=mock và có thể bỏ trống AI_API_KEY
AI_PROVIDER=mock
AI_API_KEY=

AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000

# --- Facebook Graph API ---
PAGE_ACCESS_TOKEN=

# subscribe.js yêu cầu PAGE_ID, APP_ID khi chạy npm run subscribe:page
PAGE_ID=1012636565275471
APP_ID=1999113947363340
FACEBOOK_GRAPH_VERSION=v25.0
# SIMULATE_ACTIONS=true để chỉ giả lập hành động (mặc định trong code là true khi không có PAGE_ACCESS_TOKEN)
